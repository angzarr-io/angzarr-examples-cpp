# C++ examples - container execution
#
# This file runs inside the devcontainer and executes actual build commands.
# It's mounted over justfile when running in a container. Also used
# directly in CI.
#
# Build recipes are no-ops until the repo has a CMakeLists.txt (the
# blackjack example port adds one).

set shell := ["bash", "-c"]

BUILD_DIR := "build"

default:
    @just --list

# Configure and build all C++ components
build:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f CMakeLists.txt ] || { echo "No CMake project yet; skipping build"; exit 0; }
    cmake -B {{BUILD_DIR}} -S . -DBUILD_TESTS=ON
    cmake --build {{BUILD_DIR}} -j$(nproc)

# Run unit tests (ctest)
test-unit:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f CMakeLists.txt ] || { echo "No CMake project yet; skipping test-unit"; exit 0; }
    cmake -B {{BUILD_DIR}} -S . -DBUILD_TESTS=ON
    cmake --build {{BUILD_DIR}} -j$(nproc)
    ctest --test-dir {{BUILD_DIR}} --output-on-failure

# Run acceptance tests
test-acceptance:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f CMakeLists.txt ] || { echo "No CMake project yet; skipping test-acceptance"; exit 0; }
    echo "No acceptance suite defined yet"

# Run all tests
test: test-unit test-acceptance

# Format code with clang-format
fmt:
    #!/usr/bin/env bash
    set -euo pipefail
    files=$(find . -path ./build -prune -o -path ./angzarr-client-cpp -prune -o -path ./angzarr-project -prune -o \( -name "*.cpp" -o -name "*.hpp" \) -print)
    [ -n "$files" ] || { echo "No C++ sources; skipping fmt"; exit 0; }
    echo "$files" | xargs clang-format -i

# Lint with clang-tidy (only files known to compile_commands.json)
lint:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -f CMakeLists.txt ] || { echo "No CMake project yet; skipping lint"; exit 0; }
    cmake -B {{BUILD_DIR}} -S . -DBUILD_TESTS=ON -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
    grep '"file"' {{BUILD_DIR}}/compile_commands.json \
        | sed 's/.*"file": *"//;s/".*//' \
        | grep -v '/build/' \
        | sort -u \
        | xargs clang-tidy -p {{BUILD_DIR}}

# Clean build artifacts
clean:
    rm -rf {{BUILD_DIR}}
